# OpenAI Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Milvus Vector Database Configuration (Required for RAG features)
# Used for both Employee Rules and Knowledge Book with different collections
MILVUS_HOST=localhost
MILVUS_PORT=19530  # Milvus 默认端口

# Employee Rules Collection (员工手册)
EMPLOYEE_RULES_COLLECTION=employee_rules

# Knowledge Book Collection (知识库 - 盗墓笔记)
MILVUS_COLLECTION=knowledge_book

# Redis Cache Configuration (Optional, for query caching)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL=3600

# RAG Optimization Configuration (Optional)
# Query Rewriting: Generate multiple query variants for better retrieval
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_COUNT=2

# Reranker: Re-score search results for better relevance
ENABLE_RERANKER=true
RERANKER_TYPE=auto  # Options: 'auto', 'embedding', 'llm'
RERANKER_TOPK=5

# Reranker Types Explained:
# - 'auto': Automatically choose based on query complexity (simple → embedding, complex → llm)
# - 'embedding': Fast, uses cosine similarity between query and document embeddings (similar to BGE)
# - 'llm': Most accurate, uses GPT-4o-mini for semantic relevance scoring (slower, more expensive)

# Optional: MCP Services
# EXA_API_KEY=your_exa_api_key_here

# Sports API Configuration - 体育数据 API 配置
# 选择一种方式（Choose one method）:
# 
# 方式 1: BallDontLie API (Free, 60 requests/month)
# Get from: https://www.balldontlie.io/
# SPORTS_API_PROVIDER=balldontlie
# BALLDONTLIE_API_KEY=your_balldontlie_api_key_here
#
# 方式 2: RapidAPI NBA API (推荐 Recommended)
# Get from: https://rapidapi.com/api-sports/api/api-nba
SPORTS_API_PROVIDER=rapidapi
RAPIDAPI_KEY=61b68ed8e2msh99cababffb79bf9p183be7jsn80e54a361e6e
RAPIDAPI_HOST=api-nba-v1.p.rapidapi.com

# Mem0 Long-Term Memory (Optional, for personalized memory features)
# Get your API key from: https://app.mem0.ai/
MEM0_API_KEY=your_mem0_api_key_here

# Optional: MySQL Database (for data analysis features with full CRUD operations)
MYSQL_DSN=mysql://username:password@host:port/database?sslmode=disable

